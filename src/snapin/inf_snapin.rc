LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT

IDI_APP ICON "../../res/app.ico"

#define PAGE_STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_DISABLED | WS_CAPTION
