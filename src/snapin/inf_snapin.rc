// Страницы свойств

IDD_PAGE_SETTINGS DIALOGEX 0, 0, 252, 218
STYLE PAGE_STYLE
CAPTION "Параметры"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "InfVerif (проверка из Windows Driver Kit)", -1, 7, 7, 238, 112
    LTEXT           "Путь к InfVerif.exe (пусто — найти автоматически):", -1, 14, 21, 224, 8
    EDITTEXT        IDC_VERIF_PATH, 14, 32, 170, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Обзор...", IDC_BROWSE, 188, 31, 50, 15
    LTEXT           "", IDC_VERIF_FOUND, 14, 50, 224, 18
    LTEXT           "Режим проверки:", -1, 14, 74, 224, 8
    COMBOBOX        IDC_VERIF_MODE, 14, 85, 224, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Проверка выполняется для текущего текста файла, включая несохранённые изменения.", IDC_NOTE, 14, 102, 224, 16
    LTEXT           "Параметры сохраняются в профиле пользователя и действуют во всех консолях.", -1, 7, 128, 238, 18
END

IDD_PAGE_FILE DIALOGEX 0, 0, 252, 218
STYLE PAGE_STYLE
CAPTION "Файл"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Путь:", -1, 7, 9, 50, 8
    EDITTEXT        IDC_PATH, 60, 7, 185, 14, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Кодировка:", -1, 7, 29, 50, 8
    COMBOBOX        IDC_ENCODING, 60, 27, 120, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Концы строк:", -1, 7, 47, 50, 8
    COMBOBOX        IDC_EOL, 60, 45, 120, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Символ Ctrl+Z (0x1A) в конце файла", IDC_CTRLZ, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 60, 63, 185, 10
    GROUPBOX        "Сведения", -1, 7, 80, 238, 131
    EDITTEXT        IDC_STATS, 14, 92, 224, 112, RO_MULTI | NOT WS_BORDER
END

IDD_PAGE_VERSION DIALOGEX 0, 0, 252, 218
STYLE PAGE_STYLE
CAPTION "[Version]"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Signature:", -1, 7, 9, 52, 8
    COMBOBOX        IDC_SIGNATURE, 62, 7, 183, 60, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Class:", -1, 7, 27, 52, 8
    COMBOBOX        IDC_CLASS, 62, 25, 183, 160, CBS_DROPDOWN | CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_CLASS_INFO, 62, 41, 183, 16
    LTEXT           "ClassGuid:", -1, 7, 61, 52, 8
    EDITTEXT        IDC_CLASSGUID, 62, 59, 117, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Станд.", IDC_STD_GUID, 181, 58, 31, 15
    PUSHBUTTON      "Новый", IDC_NEW_GUID, 214, 58, 31, 15
    LTEXT           "ExtensionId:", -1, 7, 79, 52, 8
    EDITTEXT        IDC_EXTID, 62, 77, 150, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Новый", IDC_NEW_EXTID, 214, 76, 31, 15
    LTEXT           "Provider:", -1, 7, 97, 52, 8
    EDITTEXT        IDC_PROVIDER, 62, 95, 183, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_PROVIDER_RESOLVED, 62, 111, 183, 8
    LTEXT           "DriverVer:", -1, 7, 125, 52, 8
    CONTROL         "", IDC_DATE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 62, 123, 70, 14
    EDITTEXT        IDC_VERSION, 135, 123, 50, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Сегодня", IDC_TODAY, 187, 122, 30, 15
    PUSHBUTTON      "+1", IDC_BUMP, 219, 122, 26, 15
    LTEXT           "CatalogFile:", -1, 7, 145, 52, 8
    EDITTEXT        IDC_CATALOG, 62, 143, 183, 14, ES_AUTOHSCROLL
    CONTROL         "PnpLockdown=1 (защита файлов драйвера от изменения)", IDC_LOCKDOWN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 62, 163, 183, 10
    LTEXT           "Изменения записываются в текст INF; сохранение файла — отдельной командой «Сохранить».", -1, 7, 185, 238, 18
END

